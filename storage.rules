rules_version = '2';

// ═══════════════════════════════════════════════════════════════
// Realmood — Firebase Storage security rules
// Each authenticated user can only write under their own UID
// subdirectory; reads are public (images are referenced by URL).
// ═══════════════════════════════════════════════════════════════
service firebase.storage {
  match /b/{bucket}/o {
    match /project-images/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
