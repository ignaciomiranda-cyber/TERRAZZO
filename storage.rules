rules_version = '2';

// ═══════════════════════════════════════════════════════════════
// Realmood — Firebase Storage security rules
// Mirrors the "public images read" / "auth images upload" policies
// in supabase-setup.sql for the project-images bucket.
// ═══════════════════════════════════════════════════════════════
service firebase.storage {
  match /b/{bucket}/o {
    match /project-images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
